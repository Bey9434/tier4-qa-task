{
  "name": "tier4-qa-task",
  "version": "1.0.0",
  "description": "Practice Software Testing を対象とした E2E テスト自動化（Playwright + TypeScript）",
  "private": true,
  "scripts": {
    "test": "dotenvx run --strict -- playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.28.2",
  "lint-staged": {
    "*.{ts,mts,cts}": "eslint --fix",
    "**/*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.19.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
